# ==========================================
# Firebase Configuration
# ==========================================
# Get these values from Firebase Console:
# https://console.firebase.google.com

# Firebase Web API Key
FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Project ID
FIREBASE_PROJECT_ID=reliq-faith-app

# Firebase App ID
FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=123456789

# Firebase Database URL (Realtime Database)
FIREBASE_DATABASE_URL=https://reliq-faith-app.firebaseio.com

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=reliq-faith-app.appspot.com

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=reliq-faith-app.firebaseapp.com

# ==========================================
# Payment Configuration
# ==========================================
# MTN Mobile Money Credentials

# MTN API Key - Get from MTN Developer Portal
MTN_API_KEY=your_mtn_api_key_here

# MTN Primary Key
MTN_PRIMARY_KEY=your_mtn_primary_key_here

# MTN API URL
MTN_API_URL=https://api.mtnmobileonsay.com

# ==========================================
# Application Settings
# ==========================================

# App Name
APP_NAME=Reliq

# App Version
APP_VERSION=1.0.0

# App Environment (development, staging, production)
APP_ENV=development

# Enable Logging
ENABLE_LOGGING=true

# Bible API Source (offline, api)
BIBLE_SOURCE=offline

# Default Theme (white, dark)
DEFAULT_THEME=white

# Default Currency for Rwanda
DEFAULT_CURRENCY=RWF
